# SecuredVault Client Environment Variables
# Copy this file to .env in the client directory to configure

# (Optional) Pinata Cloud API credentials for IPFS uploading
# Get your free API key at https://app.pinata.cloud/developers/api-keys
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# (Optional) Custom Pinata dedicated gateway (defaults to https://gateway.pinata.cloud/ipfs/)
REACT_APP_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# (Optional) Contract address (defaults to address in client/src/artifacts/contract-address.json)
REACT_APP_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
